ima_comm()
{
{{with .IMA}}{{if .IMAIsEnable}}
    if [ -d /sys/firmware/efi ]; then
        grub_path=/boot/efi/EFI/openeuler/grub.cfg
    else
        grub_path=/boot/grub2/grub.cfg
    fi
    set_kernel_param()
    {
        for param in "${@}"; do
            if ! grep -q "${param}" "${grub_path}"; then
                sed -i "/vmlinuz/ s/$/ ${param}/" "${grub_path}"
            fi
        done
        echo "Kernel parameters set successfully"
        lsinitrd | grep etc/ima/digest_lists > /dev/null
    }

    rm_kernel_param()
    {

    	for param in "${@}"; do
    		if grep -q "${param}" "${grub_path}"; then
    			sed -i "s/ \<${param}\>//g" ${grub_path}
    		fi
    	done

    }


    set_selinux_type()
    {
        module_name=$(echo "$1" | awk -F'_' '{print $1 "_" $2}')
    	semodule -l | grep $module_name > /dev/null
    	if [ $? -eq 1 ]; then
    		file=$module_name.cil
    		cat <<EOF > $file
(type $1)
(roletype object_r $1)
(typeattributeset file_type ($1))
(allow domain $1 (file (append execmod ioctl mounton relabelfrom swapon watch_reads audit_access execute link open relabelto unlink watch_sb create execute_no_trans lock quotaon rename watch watch_with_perm entrypoint getattr map read setattr watch_mount write)))
EOF
            semodule -i $file
            echo "selinux type $1 has been successfully created"
                rm $file
        fi

        chcon -t $1 $2

    }

    kernel_param=()
    remove_kernel_param=()
    appraise_enable=false
    measure_enable=false
    set_flag=false
    remove_flag=false
    packages=("ima-evm-utils" "digest-list-tools")
    for pkg in "${packages[@]}"; do
            get_usr_input "${pkg} is about to installed?【Y/N】"
            if [ $? -eq 1 ]; then
                yum install -y ${pkg} || exit 1
            fi
    done
{{if .MeasureIsEnable}}
    kernel_param+=("ima_digest_list_pcr=11" "ima_template=ima-ng" "initramtmpfs")
    measure_enable=true
{{else}}
    get_usr_input "Whether to turn off IMA measure?【Y/N】"
    if [ $? -eq 1 ]; then
        remove_kernel_param+=("ima_digest_list_pcr=11" "ima_template=ima-ng")
    fi
{{end}}

{{if .AppraiseIsEnable}}
    kernel_param+=("ima_appraise=enforce" "ima_appraise_digest_list=digest-nometadata" "initramtmpfs")
    appraise_enable=true
{{else}}
    get_usr_input "Whether to turn off IMA appraise?【Y/N】"
    if [ $? -eq 1 ]; then
        remove_kernel_param+=("ima_appraise=enforce" "ima_appraise_digest_list=digest-nometadata")
    fi
{{end}}

echo "Checking the IMA startup parameters..."
for param in "${kernel_param[@]}"; do
    if ! grep -q "${param}" /proc/cmdline ; then
        set_flag=true
        break
    fi
done

for param in "${remove_kernel_param[@]}"; do
    if grep -q "${param}" /proc/cmdline ; then
        remove_flag=true
        break
    fi
done

if [[ $set_flag == "true" || $remove_flag == "true" ]]; then
    echo "Setting the IMA startup parameters..."
    set_kernel_param "${kernel_param[@]}"
    rm_kernel_param "${remove_kernel_param[@]}"
    echo "IMA digest configuration need to be restart the system to take effect"
    echo "Please restart the system later"
else
    ima_policy=/sys/kernel/security/ima/policy
    if [ ! -z "$(cat $ima_policy)" ]; then
        echo "ima policy has been configured! It needs to restart to  overridei policy."
        return 0;
    fi

    if [[ $appraise_enable == "true" && $measure_enable == "true" ]]; then
        echo "IMA appraise and measure have been successfully enabled!"
        obj_type=ima_all_bprm_t
        echo "appraise func=BPRM_CHECK obj_type=${obj_type}" > $(pwd)ima_policy
        echo "measure func=BPRM_CHECK obj_type=${obj_type}" >> $(pwd)ima_policy
    elif $appraise_enable; then
        obj_type=ima_appraise_bprm_t
        echo "appraise func=BPRM_CHECK obj_type=${obj_type}" > $(pwd)ima_policy
        echo "IMA appraise is successfully enabled!"
    elif $measure_enable; then
        obj_type=ima_measure_bprm_t
        echo "measure func=BPRM_CHECK obj_type=${obj_type}" > $(pwd)ima_policy
        echo "IMA measure is successfully enabled!"
    else
        echo "IMA has been disabled successfully!"
        return 0
    fi
{{range .ProtectedFiles}}
    set_selinux_type $obj_type  {{.}}
    if [ -z "$(cat $ima_policy)"]; then
        echo "appraise func=DIGEST_LIST_CHECK appraise_type=imasig|modisg" >> $(pwd)ima_policy
        echo "measure func=DIGEST_LIST_CHECK" >> $(pwd)ima_policy
        echo "$(pwd)ima_policy" >> $ima_policy
        rm $(pwd)ima_policy
    fi
    echo "Successfully turned on IMA protection for {{.}}"
fi
{{end}}
    return 0
{{else}}
    echo "IMA is not configured."
    return 0
{{end}}
{{end}}
}

